include README.md CHANGELOG.md uv.lock setup.cfg
# Drop setuptools' automatic test discovery, then include reviewed files only.
prune tests
include tests/test_abs_census_etl.py tests/test_packaging_checks.py
include tests/test_data_features.py tests/check_abs_data.py
include tests/check_mutations.py tests/check_packaging.py

# User and maintainer reference documentation linked from the packaged README.
include docs/installation.md docs/data-guide.md docs/development.md
include docs/release-assets.md
# Dated internal handoff must not become a future release-status claim.
exclude docs/release-readiness.md
